{
  "name": "memex",
  "version": "1.7.1",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build:shared": "pnpm --filter @memex/shared build",
    "build": "pnpm build:shared && pnpm --filter @memex/mcp build && pnpm --filter @memex/app build",
    "build:e2e": "cross-env MEMEX_SUPABASE_URL= MEMEX_SUPABASE_ANON_KEY= pnpm build",
    "dev": "pnpm build:shared && pnpm --filter @memex/app dev",
    "test": "pnpm build:shared && pnpm -r test",
    "typecheck": "pnpm build:shared && pnpm -r typecheck",
    "dist": "pnpm build && pnpm --filter @memex/app dist",
    "test:e2e": "pnpm build:e2e && playwright test",
    "test:e2e:team": "pnpm build:e2e && playwright test e2e/team.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "cross-env": "^10.1.0",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
